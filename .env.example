# ==================================================
# Botocharcoal Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==================================================

# --- Application ---
APP_ENV=development
# Change to "production" in production
SECRET_KEY=change-me-to-a-random-secure-string
BASE_URL=http://localhost:8000
# Allowed hosts for FastAPI (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# For Alembic migrations, use sync driver (psycopg2):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# For the app (async), use async driver (asyncpg):
DATABASE_URL=postgresql+asyncpg://botocharcoal:password@localhost:5432/botocharcoal

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- AI / OpenAI ---
# API key for text + image generation (OpenAI or compatible API)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model names (can be overridden in admin /admin/ai-settings)
TEXT_MODEL=gpt-4o
IMAGE_MODEL=dall-e-3

# --- AI Settings (per-project in database, override .env) ---
# Provider: openai, anthropic, or custom
# AI_SETTINGS_PROVIDER=openai
# AI_SETTINGS_API_KEY=your-api-key
# AI_SETTINGS_API_BASE_URL=https://api.openai.com/v1
# AI_SETTINGS_TEXT_MODEL=gpt-4o
# AI_SETTINGS_IMAGE_MODEL=dall-e-3
# AI_SETTINGS_IMAGE_SIZE=1024x1024

# --- Instagram Graph API ---
GRAPH_API_VERSION=v20.0
IG_LONG_LIVED_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Storage ---
MEDIA_ROOT=media
MEDIA_URL=/media/

# --- Admin Session ---
ADMIN_SESSION_MAX_AGE=86400

# --- Celery ---
CELERY_MAX_RETRIES=3

# --- Admin Bootstrap (used by scripts/create_admin.py) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
